---
layout: base.njk
---
<div class="collection-shell collection-shell--author-detail">
  {% include "partials/nav_desktop.njk" %}

  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12 p-3 p-md-5">
        {% set authorKey = page.fileSlug %}
        {% set authorKeySlug = authorKey | authorSlug %}
        {% set postsByAuthor = tagIndex.authors.all.map[authorKeySlug] or tagIndex.authors.all.map[authorKey] or [] %}
        <h1 class="p-name text-center"><strong><span class="none text-dark">{{ title }}</span></strong></h1>

        {% if postsByAuthor.length %}
          <div class="text-center text-secondary mb-5">
            {% set authorProfileImage = (image | ensureImage('/images/jcrt.svg')) if image else ('/images/jcrt.svg') %}
            <img class="img-thumb rounded-circle mb-3 reading-author-image" alt="{{ title }}" width="150" height="150"
                 src="{{ authorProfileImage | preferWebp }}" data-fallback-src="{{ authorProfileImage }}" onerror="if(this.dataset.fallbackAttempted){this.onerror=null;this.src='/images/jcrt.svg';}else{this.dataset.fallbackAttempted='1';this.src=this.dataset.fallbackSrc||'/images/jcrt.svg';}"/>
            {% set authorMeta = affiliation or description %}
            {% if authorMeta %}
              <h2 class="h5 text-primary text-uppercase mb-3">{{ authorMeta }}</h2>
            {% endif %}
            {% if bio %}
              <p class="lead italic mb-3">{{ bio }}</p>
            {% elif description and description != authorMeta %}
              <p class="lead italic mb-3">{{ description }}</p>
            {% endif %}
          
          {% if orcid and orcid != "/" %}
            <div class="mb-3">
              <a href="{{ orcid }}" target="_blank" class="text-decoration-none text-dark small">
                <img src="/images/external/orcid-org-orcid-logo-icon-30cf5199eb.webp" width="16" class="me-1" alt="ORCID">
                {{ orcid | replace("https://orcid.org/", "") }}
              </a>
            </div>
          {% endif %}
            {# div, not <p>: browsers auto-close a <p> at <details> (flow content),
               which forced the post count and the links dropdown onto separate lines. #}
            <div class="d-flex align-items-baseline flex-wrap column-gap-2 mb-3 justify-content-center">
  <span>{{ postsByAuthor.length }} Posts |</span>

  {% if social %}
    {% if social.length > 1 %}
      {# Multiple links: collapse into a dropdown instead of a run of raw URLs. #}
      <details class="author-social d-inline-block align-middle">
        <summary class="text-decoration-none text-dark small" role="button">
          <svg class="icon-svg" aria-hidden="true"><use href="#fa-link"/></svg>
          Links ({{ social.length }})
        </summary>
        <ul class="list-unstyled mb-0 mt-2 ms-1">
          {% for s in social %}
            <li class="mb-1">
              <a href="{{ s.url | default('#') }}"
                 title="{{ s.title }}"
                 target="_blank"
                 rel="noopener"
                 class="text-decoration-none text-dark small"
                 aria-label="{{ s.title }} of {{ title }}">
                <svg class="icon-svg me-1" aria-hidden="true"><use href="#{{ s.icon | iconId }}"/></svg>
                {{ (s.url | mainDomain) or s.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </details>
    {% else %}
      {% for s in social %}
        <a href="{{ s.url | default('#') }}"
           title="{{ s.title }}"
           target="_blank"
           rel="noopener"
           class="text-decoration-none text-dark me-3"
           aria-label="{{ s.title }} of {{ title }}">
          <svg class="icon-svg" aria-hidden="true"><use href="#{{ s.icon | iconId }}"/></svg>
          <span class="small ms-1">{{ (s.url | mainDomain) or s.title }}</span>
        </a>
      {% endfor %}
    {% endif %}
  {% endif %}
</div>

            <p>
              {% if button %}
                {% for b in button %}
                  <a href="{{ b.url }}" class="btn btn-primary me-2 text-white">{{ b.title }}</a>
                {% endfor %}
              {% endif %}
            </p>
          </div>

          <hr/>
          <div class="row mt-4">
            {% for b in postsByAuthor %}
              <div class="col-md-4 col-lg-4 p-3 p-md-4"> 
                <div class="img-zoom-container mb-3">
                  <a href="{{ b.url }}" title="{{ b.title | stripMd }}">
                    {% set authorPostImage = (b.image | ensureImage('/images/jcrt-open-graph.webp')) if b.image else ('/images/jcrt-open-graph.webp') %}
                    <img class="img-post rounded" alt="{{ b.title | stripMd }}" src="{{ authorPostImage | preferWebp }}" data-fallback-src="{{ authorPostImage }}" {% imageAttrs authorPostImage, 640, 360 %} loading="lazy" decoding="async" onerror="if(this.dataset.fallbackAttempted){this.onerror=null;this.src='/images/jcrt-open-graph.webp';}else{this.dataset.fallbackAttempted='1';this.src=this.dataset.fallbackSrc||'/images/jcrt-open-graph.webp';}"/>
                  </a>
                </div>
                <h3 class="h5"><strong>{{ b.title | mdInline | safe }}</strong></h3>
                <p class="small text-muted">
                  {{ b.description }}
                </p>
                <p>
                  <a href="{{ b.url }}" class="btn  btn-primary">Learn More</a>
                </p>
              </div>
            {% endfor %}
          </div>

        {% else %}
          <div class="text-center p-5">
            <p class="lead">Nothing Post by <strong>{{ title }}</strong>.</p>
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</div>
