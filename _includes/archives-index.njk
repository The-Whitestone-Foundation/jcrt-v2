---
layout: base.njk
---
<div class="reading-shell reading-shell--archive-index">
  {% include "partials/nav_desktop.njk" %}
  <div class="row">
    <div class="col-md-12 p-3 p-md-5">
      <header class="reading-header mb-5 border-bottom pb-4">
	        {% if date %}<p class="text-secondary dt-published">{{ date | readableDate("dd LLLL yyyy") }}</p>{% endif %}
	        <h1 class="hero-post-title p-name"><strong>{{ title }}</strong></h1>
	        {% if description %}<h2 class="lead text-secondary">{{ description }}</h2>{% endif %}
	        
	        <p>
          {% if social %}
            {% for s in social %}
              <a href="{{ s.url }}" title="{{ s.title }}"><svg class="icon-svg me-2" aria-hidden="true"><use href="#{{ s.icon | iconId }}"/></svg></a>
            {% endfor %}
          {% endif %}
        </p>
        
        <p>
          {% if button %}
            {% for b in button %}
              <a href="{{ b.url }}" class="btn btn-primary me-2 text-white">{{ b.title }}</a>
            {% endfor %}
          {% endif %}
        </p>
      </header>

      {% if image %}
        {% set archiveIndexImage = image | ensureImage('/images/jcrt-open-graph.webp') %}
        <img class="img-post mb-5 rounded" alt="{{ title }}" src="{{ archiveIndexImage | preferWebp }}" data-fallback-src="{{ archiveIndexImage }}" {% imageAttrs archiveIndexImage, 1200, 675 %} loading="lazy" decoding="async" onerror="if(this.dataset.fallbackAttempted){this.onerror=null;this.src='/images/jcrt-open-graph.webp';}else{this.dataset.fallbackAttempted='1';this.src=this.dataset.fallbackSrc||'/images/jcrt-open-graph.webp';}"/>
      {% endif %}

	      <article class="reading-body serif e-content">
	        {{ content | toc | safe }}
	        {{ content | safe }}
      </article>
    </div> 
  </div>
</div> 
