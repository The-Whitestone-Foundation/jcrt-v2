<div class="jcrt-frame jcrt-frame--archive">
  {% include "partials/nav_desktop.njk" %}
  {% set urlParts = (page.url or '').split('/') %}
  {% set issueSlug = urlParts[2] or '' %}
  {% set isIssueIndex = page.url and page.url.startsWith('/archives/') and page.url.endsWith('/') and (urlParts | length) == 4 and issueSlug.includes('.') %}
  {% set isTheoryPost = tags and ("theoryPosts" in tags) %}
  {% set displayVolume = jsonEntry.volume or volume %}
  {% set displayIssue = jsonEntry.issue or issue %}
  {% set displaySeason = jsonEntry.season or season %}
  {% set displayDate = jsonEntry.date or date %}
  {% set displayArticleNumber = jsonEntry.article_number or article_number %}
  {% set issueCrumbSlug = issueSlug %}
  {% if not issueCrumbSlug and displayVolume and displayIssue %}
    {% set issueCrumbSlug = displayVolume ~ "." ~ displayIssue %}
  {% endif %}

  <article class="jcrt-article jcrt-article--archive">
      <header class="jcrt-article-header">
        <nav aria-label="breadcrumb" class="jcrt-breadcrumb">
          <ol>
            <li class="breadcrumb-item"><a href="/" class="text-primary text-decoration-none">Home</a></li>
            {% if isTheoryPost %}
              <li class="breadcrumb-item"><a href="/religioustheory/" class="text-primary text-decoration-none">Religious Theory</a></li>
            {% else %}
              <li class="breadcrumb-item"><a href="/archives/" class="text-primary text-decoration-none">Archives</a></li>
              {% if issueCrumbSlug %}
                {% if isIssueIndex %}
                  <li class="breadcrumb-item active text-primary" aria-current="page">{{ issueCrumbSlug }}</li>
                {% else %}
                  <li class="breadcrumb-item"><a href="/archives/{{ issueCrumbSlug }}/" class="text-primary text-decoration-none">{{ issueCrumbSlug }}</a></li>
                {% endif %}
              {% endif %}
              {% if not isIssueIndex and displayArticleNumber %}
                <li class="breadcrumb-item active text-primary" aria-current="page">Article No. {{ displayArticleNumber }}</li>
              {% endif %}
            {% endif %}
          </ol>
        </nav>

        <h1 class="jcrt-article-title p-name">{{ jsonEntry.title or title }}</h1>

        {% if isIssueIndex %}
          {% set issueImage = (image | ensureImage('/images/jcrt-open-graph.webp')) if image else (metadata.files_url + '/images/logos/JCRT.svg') %}
          {% set issueImageWidth = issue_image_width %}
          {% set issueImageHeight = issue_image_height %}
          <figure class="jcrt-article-media">
            <img
              src="{{ issueImage | preferWebp }}"
              data-fallback-src="{{ issueImage }}"
              alt="{{ title or 'Journal issue cover image' }}"
              class="jcrt-article-image {% if issueImageWidth and issueImageHeight %}issue-index-cover issue-index-cover--custom{% endif %}"
              {% if issueImageWidth and issueImageHeight %}
              width="{{ issueImageWidth }}"
              height="{{ issueImageHeight }}"
              style="--issue-cover-width: {{ issueImageWidth }}px; --issue-cover-height: {{ issueImageHeight }}px;"
              {% else %}
              {% imageAttrs issueImage, 1200, 675 %}
              {% endif %}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              onerror="if(this.dataset.fallbackAttempted){this.onerror=null;this.src='{{ metadata.files_url }}/images/jcrt-open-graph.webp';}else{this.dataset.fallbackAttempted='1';this.src=this.dataset.fallbackSrc||'{{ metadata.files_url }}/images/jcrt-open-graph.webp';}"
            >
          </figure>
        {% endif %}

        {% if not isIssueIndex and image %}
          {% set defaultPostImage = metadata.files_url + "/images/jcrt-open-graph.webp" %}
          {% set postImage = (image | ensureImage(defaultPostImage)) %}
          {% set postImagePreferred = (postImage | preferWebp) %}
          <figure class="jcrt-article-media">
            <img
              src="{{ postImagePreferred }}"
              data-fallback-src="{{ postImage }}"
              alt="{{ title }}"
              class="jcrt-article-image"
              {% imageAttrs postImage, 1200, 675 %}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              onerror="if(this.dataset.fallbackAttempted){this.onerror=null;this.src='{{ metadata.files_url }}/images/jcrt-open-graph.webp';}else{this.dataset.fallbackAttempted='1';this.src=this.dataset.fallbackSrc||'{{ metadata.files_url }}/images/jcrt-open-graph.webp';}"
            >
          </figure>
        {% endif %}

        {% set authorRaw = jsonEntry.author or author %}
        {% if authorRaw %}
          <div class="jcrt-article-byline p-author h-card">
            {% set authorNames = authorRaw | splitAuthors %}
            <span class="fw-bold text-dark">
              {%- for aName in authorNames -%}
                {% set authorObj = collections.authors | getAuthorObj(aName) %}
                {%- if (aName | lower) in ["editors", "editor"] -%}
                  <a href="/editors/" class="text-decoration-underline text-dark hover-primary p-name u-url">{{ aName }}</a>
                {%- elif authorObj -%}
                  <a href="{{ authorObj.url }}" class="text-decoration-underline text-dark hover-primary p-name u-url">{{ aName }}</a>
                {%- else -%}
                  <span class="p-name">{{ aName }}</span>
                {%- endif -%}
                {%- if not loop.last -%}; {% endif -%}
              {%- endfor -%}
            </span>
            {% if affiliation or affilation %}<br><small class="text-secondary">{{ affiliation or affilation }}</small>{% endif %}
          </div>
        {% endif %}

        <div class="jcrt-action-row jcrt-action-row--meta">
          {% if displayDate %}
            <span class="dt-published"><i class="bi bi-calendar3"></i> {{ displayDate | postDate }}</span>
          {% endif %}
          {% if not isIssueIndex and pdfUrl %}
            <a href="{{ pdfUrl }}" title="Download Article as a PDF" class="btn btn-primary px-3 shadow-sm" target="_blank">
              <i class="bi bi-file-earmark-pdf"></i> Download Article
            </a>
          {% endif %}
          {% if not isIssueIndex and risCitationUrl %}
            <a href="{{ risCitationUrl }}" title="Download citation as RIS" class="btn btn-outline-primary px-3 shadow-sm" download>
              <i class="bi bi-journal-text"></i> Download Citation (RIS)
            </a>
          {% endif %}
          {% if not isIssueIndex and jsonCitationUrl %}
            <a href="{{ jsonCitationUrl }}" title="Download citation as CSL JSON" class="btn btn-outline-secondary px-3 shadow-sm" download>
              <i class="bi bi-braces"></i> Download Citation (JSON)
            </a>
          {% endif %}
        </div>
      </header>

      {% if abstract %}
      <section class="jcrt-abstract">
        <h2>Abstract</h2>
        <div class="serif italic">{{ abstract | markdownify | safe }}</div>
      </section>
      {% endif %}

      <div class="jcrt-article-content article-body serif archive-content">
        {% set finalHTML = jsonEntry.content | markdownify if jsonEntry.content else content %}
        {% if not isIssueIndex %}
        <div id="custom-toc-container" class="jcrt-toc d-none">
          <h2>Table of Contents</h2>
          <ul id="toc-list" class="list-unstyled mb-0"></ul>
        </div>
        {% endif %}

        <div id="article-content" class="e-content">
          {{ finalHTML | safe }}
        </div>
      </div>

      {% set ignoredTags = ["all", "posts", "archives", "theoryPosts", "nav"] %}
      {% set displayKeywords = [] %}
      {% if archiveKeywords and archiveKeywords.length > 0 %}
        {% set displayKeywords = archiveKeywords %}
      {% elif tags and tags.length > 0 %}
        {% for tag in tags %}
          {% if tag not in ignoredTags %}
            {% set displayKeywords = (displayKeywords.push(tag), displayKeywords) %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% set shareTitle = jsonEntry.title or title or metadata.site.title %}
      {% set canonicalPath = (canonical_url or page.url) | stripQueryAndHash %}
      {% set shareUrl = canonicalUrl or (canonicalPath if "http" in canonicalPath else metadata.url + canonicalPath) %}
      {% set encodedShareUrl = shareUrl | urlencode %}
      {% set encodedShareTitle = shareTitle | urlencode %}
      {% set shareOpenlyHref = "https://shareopenly.org/share/?url=" + shareUrl + "&text=" + shareTitle %}

      <footer class="jcrt-article-footer">
        {% if displayKeywords and displayKeywords.length > 0 %}
        <div class="jcrt-taxonomy-row">
          <span class="jcrt-footer-label">{% if isTheoryPost %}Tags{% else %}Keywords{% endif %}:</span>
          {% set tagUrlBase = "/religioustheory/tags/" if isTheoryPost else "/archives/keywords/" %}
          {% for keyword in displayKeywords %}
            {% set hasArchiveKeywordPage = isTheoryPost or (tagIndex and tagIndex.archiveKeywords and tagIndex.archiveKeywords.map and tagIndex.archiveKeywords.map[keyword] and tagIndex.archiveKeywords.map[keyword].length) %}
            {% if isLeanBuild or not hasArchiveKeywordPage %}
            <span class="badge bg-light text-dark border fw-normal">{{ keyword }}</span>
            {% else %}
            <a href="{{ tagUrlBase }}{{ keyword | slugify }}/" class="badge bg-light text-dark border fw-normal text-decoration-none">{{ keyword }}</a>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}

        {% if isTheoryPost and categories and categories.length > 0 %}
        <div class="jcrt-taxonomy-row">
          <span class="jcrt-footer-label">Categories:</span>
          {% for cat in categories %}
            {% if isLeanBuild %}
            <span class="badge bg-light text-dark border fw-normal">{{ cat }}</span>
            {% else %}
            <a href="/religioustheory/categories/{{ cat | slugify }}/" class="badge bg-light text-dark border fw-normal text-decoration-none">{{ cat }}</a>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}

        {% if not isIssueIndex %}
        {% set hasFooterMeta = (displayKeywords and displayKeywords.length > 0) or (isTheoryPost and categories and categories.length > 0) %}
        <div class="jcrt-action-row {% if hasFooterMeta %}jcrt-action-row--spaced{% endif %}" data-pagefind-ignore>
          <a
            href="{{ shareOpenlyHref }}"
            class="btn btn-outline-secondary btn-sm"
            target="_blank"
            rel="noopener noreferrer"
            title="Share this page with ShareOpenly"
            aria-label="Share this page with ShareOpenly"
          >
            Share Openly
          </a>

          <div class="resp-sharing-buttons" aria-label="Share this page">
            <a class="resp-sharing-button__link" href="https://facebook.com/sharer/sharer.php?u={{ encodedShareUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
              <div class="resp-sharing-button resp-sharing-button--facebook resp-sharing-button--small"><div aria-hidden="true" class="resp-sharing-button__icon resp-sharing-button__icon--solidcircle">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 0C5.38 0 0 5.38 0 12s5.38 12 12 12 12-5.38 12-12S18.62 0 12 0zm3.6 11.5h-2.1v7h-3v-7h-2v-2h2V8.34c0-1.1.35-2.82 2.65-2.82h2.35v2.3h-1.4c-.25 0-.6.13-.6.66V9.5h2.34l-.24 2z"/></svg>
                </div>
              </div>
            </a>
            <a class="resp-sharing-button__link" href="https://twitter.com/intent/tweet/?text={{ encodedShareTitle }}&amp;url={{ encodedShareUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X (Twitter)">
              <div class="resp-sharing-button resp-sharing-button--twitter resp-sharing-button--small"><div aria-hidden="true" class="resp-sharing-button__icon resp-sharing-button__icon--solidcircle">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 0C5.38 0 0 5.38 0 12s5.38 12 12 12 12-5.38 12-12S18.62 0 12 0zm5.26 9.38v.34c0 3.48-2.64 7.5-7.48 7.5-1.48 0-2.87-.44-4.03-1.2 1.37.17 2.77-.2 3.9-1.08-1.16-.02-2.13-.78-2.46-1.83.38.1.8.07 1.17-.03-1.2-.24-2.1-1.3-2.1-2.58v-.05c.35.2.75.32 1.18.33-.7-.47-1.17-1.28-1.17-2.2 0-.47.13-.92.36-1.3C7.94 8.85 9.88 9.9 12.06 10c-.04-.2-.06-.4-.06-.6 0-1.46 1.18-2.63 2.63-2.63.76 0 1.44.3 1.92.82.6-.12 1.95-.27 1.95-.27-.35.53-.72 1.66-1.24 2.04z"/></svg>
                </div>
              </div>
            </a>
            <a class="resp-sharing-button__link" href="https://www.tumblr.com/widgets/share/tool?posttype=link&amp;title={{ encodedShareTitle }}&amp;caption={{ encodedShareTitle }}&amp;content={{ encodedShareUrl }}&amp;canonicalUrl={{ encodedShareUrl }}&amp;shareSource=tumblr_share_button" target="_blank" rel="noopener noreferrer" aria-label="Share on Tumblr">
              <div class="resp-sharing-button resp-sharing-button--tumblr resp-sharing-button--small"><div aria-hidden="true" class="resp-sharing-button__icon resp-sharing-button__icon--solidcircle">
                <svg version="1.1" x="0px" y="0px" width="24px" height="24px" viewBox="0 0 24 24" enable-background="new 0 0 24 24" xml:space="preserve">
                    <path d="M12,0C5.383,0,0,5.383,0,12s5.383,12,12,12s12-5.383,12-12S18.617,0,12,0z M15.492,17.616C11.401,19.544,9.5,17,9.5,14.031 V9.5h-2V8.142c0.549-0.178,1.236-0.435,1.627-0.768c0.393-0.334,0.707-0.733,0.943-1.2c0.238-0.467,0.401-0.954,0.49-1.675H12.5v3h2 v2h-2v3.719c0,2.468,1.484,2.692,2.992,1.701V17.616z"/>
                 </svg>
                </div>
              </div>
            </a>
            <a class="resp-sharing-button__link" href="mailto:?subject={{ encodedShareTitle }}&amp;body={{ encodedShareUrl }}" target="_self" rel="noopener" aria-label="Share by email">
              <div class="resp-sharing-button resp-sharing-button--email resp-sharing-button--small"><div aria-hidden="true" class="resp-sharing-button__icon resp-sharing-button__icon--solidcircle">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 0C5.38 0 0 5.38 0 12s5.38 12 12 12 12-5.38 12-12S18.62 0 12 0zm8 16c0 1.1-.9 2-2 2H6c-1.1 0-2-.9-2-2V8c0-1.1.9-2 2-2h12c1.1 0 2 .9 2 2v8z"/><path d="M17.9 8.18c-.2-.2-.5-.24-.72-.07L12 12.38 6.82 8.1c-.22-.16-.53-.13-.7.08s-.15.53.06.7l3.62 2.97-3.57 2.23c-.23.14-.3.45-.15.7.1.14.25.22.42.22.1 0 .18-.02.27-.08l3.85-2.4 1.06.87c.1.04.2.1.32.1s.23-.06.32-.1l1.06-.9 3.86 2.4c.08.06.17.1.26.1.17 0 .33-.1.42-.25.15-.24.08-.55-.15-.7l-3.57-2.22 3.62-2.96c.2-.2.24-.5.07-.72z"/></svg>
                </div>
              </div>
            </a>
          </div>
        </div>
        {% endif %}
      </footer>
    </article>
</div>

{% if not isIssueIndex %}
<script>
document.addEventListener("DOMContentLoaded", function() {
  const content = document.getElementById('article-content');
  const tocList = document.getElementById('toc-list');
  const tocContainer = document.getElementById('custom-toc-container');
  if (!content || !tocList || !tocContainer) return;
  const headings = content.querySelectorAll('h2, h3');

  if (headings.length > 0) {
    tocContainer.classList.remove('d-none');
    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = 'section-' + index;
      const li = document.createElement('li');
      li.className = heading.tagName === 'H3' ? 'ms-3 my-1' : 'my-1';
      const a = document.createElement('a');
      a.href = '#' + heading.id;
      a.textContent = heading.textContent;
      a.className = 'text-decoration-none text-dark hover-primary';
      li.appendChild(a);
      tocList.appendChild(li);
    });
  }
});
</script>
{% endif %}
