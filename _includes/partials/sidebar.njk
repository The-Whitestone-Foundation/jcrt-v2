<button id="menu-toggle-btn" class="menu-toggle-editorial" aria-label="sidebar menu for navigation">
    <svg class="icon-svg" aria-hidden="true"><use href="#fa-bars"/></svg>
</button>

<section id="sidebar-container" data-pagefind-ignore>
<div id="sidebar-menu">

<div class="mb-3 p-3">
<div id="search"></div>
<noscript>
    <form action="/search/" method="get" role="search" style="display:flex;gap:8px;">
        <input type="search" name="q" placeholder="Search" aria-label="Search" style="flex:1;min-width:0;padding:8px;border:1px solid #ccc;-webkit-appearance:none;box-sizing:border-box;">
        <button type="submit" class="btn btn-primary btn-sm">Go</button>
    </form>
</noscript>
<script>
    window.addEventListener("DOMContentLoaded", () => {
        window.lazyPagefindSearch?.("#search");
    });
</script>
</div>

<div class="p-3 bg-light"> 
		
<h3 class="mb-4"><span class="bgb-primary p-1">{{metadata.sidebar.menu.title}}</span></h3>
<ul class="nav-editorial">
  {% for n in metadata.sidebar.menu.list %}
    <li class="nav-item-editorial">
      <a href="{{n.url}}" class="border-bottom">{{n.nav}}</a>
    </li>
  {% endfor %}
</ul>

<div class="sidebar-section">
    {% for section in metadata.sidebar.info.sections %}
        <h3 class="editorial-heading">{{ section.title }}</h3>
        {% for i in section.list %}
            <div class="editorial-card">
                <a href="{{i.url}}">
                    {% set sideImg = i.image | ensureImage('/images/jcrt-open-graph.webp') %}
                    {% set sideImgPreferred = sideImg | preferWebp %}
                    <img class="editorial-img sidebar-square-img" src="{{sideImgPreferred}}" data-fallback-src="{{sideImg}}" alt="{{i.text}}" {% imageAttrs sideImg, 400, 400 %} loading="lazy" decoding="async" onerror="if(this.dataset.fallbackAttempted){this.onerror=null;this.src='{{ metadata.files_url }}/images/jcrt-open-graph.webp';}else{this.dataset.fallbackAttempted='1';this.src=this.dataset.fallbackSrc||'{{ metadata.files_url }}/images/jcrt-open-graph.webp';}"/>
                </a>
                <p class="editorial-caption">{{i.text}}</p>
            </div>
        {% endfor %}
    {% endfor %}
	<a href="{{metadata.sidebar.info.button.url}}" class="btn btn-s, btn-primary text-uppercase">{{metadata.sidebar.info.button.text}}</a></p>
</div>

			
<div class="smaller">
<h3 class="mt-3 mb-5"><span class="bgb-primary p-1">{{metadata.sidebar.contact.title}}</span></h3>
<p>
{{metadata.sidebar.contact.text}}
</p>
{% for c in metadata.sidebar.contact.list %}<p class="mb-3">
<svg class="icon-svg me-3 text-primary" aria-hidden="true"><use href="#{{c.icon | iconId}}"/></svg>{% if c.url %}<a href="{{c.url}}">{{c.title}}</a>{% else %}{{c.title}}{% endif %}</p><hr/>{% endfor %}
</div>
			
<div class="mt-5">
<p class="smallers">
{{ metadata.sidebar_footer.text | safe }}
</p>
<p class="mt-3">
<a href="https://duotrope.com/magazine/journal-cultural-religious-theory-20464?ref=lst-7vbKB-7r3u0g8&pc=L-7VBKB" target="_top" title="Listed at Duotrope" rel="external noopener">
  <img
    src="https://cdn.duotrope.com/linkto/listedat-magic-black-480-240.png"
    data-stage="cdn"
    width="120" height="60"
    loading="lazy" decoding="async"
    alt="Listed at Duotrope"
    style="border: 1px solid gray; border-radius: 6px;"
    onerror="var d=this.dataset,w=d.color==='white';if(d.stage==='cdn'){d.stage='webp';this.src=w?'/badges/duotrope-white.webp':'/badges/duotrope-black.webp';}else if(d.stage==='webp'){d.stage='png';this.src=w?'/badges/duotrope-white.png':'/badges/duotrope-black.png';}else{this.onerror=null;}"
    onmouseover="var d=this.dataset;d.color='white';this.src=d.stage==='cdn'?'https://cdn.duotrope.com/linkto/listedat-magic-white-480-240.png':d.stage==='webp'?'/badges/duotrope-white.webp':'/badges/duotrope-white.png';"
    onmouseout="var d=this.dataset;d.color='black';this.src=d.stage==='cdn'?'https://cdn.duotrope.com/linkto/listedat-magic-black-480-240.png':d.stage==='webp'?'/badges/duotrope-black.webp':'/badges/duotrope-black.png';"
  />
</a>
</p>
</div>

</div>
</div>
</section>
