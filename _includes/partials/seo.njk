<style>{% getBundle "css" %}</style>

{% set pageSchemaType = "ScholarlyArticle" if isArchivesArticlePage else ("Blog" if isBlogHome else ("BlogPosting" if isBlogPost else "WebPage")) %}
{% set schemaAuthors = authorName | splitAuthors %}
{% set citationPublicationDate = publishedDate.split("T")[0] if publishedDate else "" %}

{% if pageParts[1] == "archives" and not isArchivesArticlePage %}
  {% for subject in (subjects or []) %}
  <meta property="dc:subject" content="{{ subject.label }}" data-subject-scheme="{{ subject.scheme }}" data-subject-identifier="{{ subject.identifier }}" data-subject-uri="{{ subject.uri }}" data-subject-category="{{ subject.category }}" />
  {% endfor %}
{% endif %}

{# ── Dublin Core article + Google Scholar citation tags (article detail pages only) ── #}
{% if isArchivesArticlePage %}
  <link rel="cite-as" href="{{ fairPageUrl }}" />
  <link rel="type" href="https://schema.org/ScholarlyArticle" />
  <link rel="describedby" type="application/ld+json" profile="https://schema.org/" href="{{ fairMetadataUrl }}" />
  <meta property="zotero:itemType" content="journalArticle" />
  <meta property="dc:type" content="article" />
  <meta property="dc:date" content="{{ citationPublicationDate or publishedDate }}" />
  <meta property="dc:identifier" content="{{ canonicalUrl }}" />
  <meta property="dc:identifier" content="ISSN:1530-5228" />
  <meta property="dc:source" content="The Journal for Cultural and Religious Theory, ISSN 1530-5228" />
  {% if pageDesc %}<meta property="dc:description" content="{{ pageDesc }}" />{% endif %}
  {% for kw in (keywords or []) %}
  <meta property="dc:subject" content="{{ kw | replace('-', ' ') }}" />
  {% endfor %}
  {% for subject in (subjects or []) %}
  <meta property="dc:subject" content="{{ subject.label }}" data-subject-scheme="{{ subject.scheme }}" data-subject-identifier="{{ subject.identifier }}" data-subject-uri="{{ subject.uri }}" data-subject-category="{{ subject.category }}" />
  {% endfor %}
  {% for aName in schemaAuthors %}
  <meta property="dc:creator" content="{{ aName }}" />
  <meta name="citation_author" content="{{ aName }}" />
  {% endfor %}
  <meta name="citation_title" content="{{ pageTitle }}" />
  <meta name="citation_journal_title" content="The Journal for Cultural and Religious Theory" />
  <meta name="citation_issn" content="1530-5228" />
  <meta name="citation_publication_date" content="{{ citationPublicationDate or publishedDate }}" />
  <meta name="citation_date" content="{{ citationPublicationDate or publishedDate }}" />
  {% if doi %}<meta name="citation_doi" content="{{ doi }}" />{% endif %}
  <meta name="citation_fulltext_html_url" content="{{ canonicalUrl }}" />
  {% if volume %}<meta name="citation_volume" content="{{ volume }}" />{% endif %}
  {% if issue %}<meta name="citation_issue" content="{{ issue }}" />{% endif %}
  {% if pages %}
    {% set pageRange = pages | parsePageRange %}
    {% if pageRange.start %}<meta name="citation_firstpage" content="{{ pageRange.start }}" />{% endif %}
    {% if pageRange.end %}<meta name="citation_lastpage" content="{{ pageRange.end }}" />{% endif %}
  {% endif %}
  {% if pdfUrl %}
  <meta name="citation_pdf_url" content="{{ pdfUrl }}" />
  {% endif %}
  {# ── PRISM metadata (academic archive pages) ── #}
  <meta name="prism.publicationName" content="Journal for Cultural and Religious Theory" />
  <meta name="prism.issn" content="1530-5228" />
  {% if volume %}<meta name="prism.volume" content="{{ volume }}" />{% endif %}
  {% if issue %}<meta name="prism.number" content="{{ issue }}" />{% endif %}
  {% if pages %}
    {% set prismPages = pages | parsePageRange %}
    {% if prismPages.start %}<meta name="prism.startingPage" content="{{ prismPages.start }}" />{% endif %}
    {% if prismPages.end %}<meta name="prism.endingPage" content="{{ prismPages.end }}" />{% endif %}
  {% endif %}
  {% if citationPublicationDate or publishedDate %}<meta name="prism.publicationDate" content="{{ citationPublicationDate or publishedDate }}" />{% endif %}
{% elif "/authors/" in pageUrl %}
  <meta property="dc:type" content="text" />
  <meta property="dc:creator" content="{{ pageTitle }}" />
{% elif isBlogPost %}
  {% if isTheoryArticlePage %}
  <link rel="cite-as" href="{{ fairPageUrl }}" />
  <link rel="type" href="https://schema.org/BlogPosting" />
  <link rel="describedby" type="application/ld+json" profile="https://schema.org/" href="{{ fairMetadataUrl }}" />
  {% endif %}
  {% set blogPublicationName = 'JCRT - Religious Theory Blog' if isTheoryArticlePage else 'JCRT - News' %}
  <meta property="zotero:itemType" content="blogPost" />
  <meta property="dc:type" content="article" />
  <meta property="dc:title" content="{{ pageTitle }}" />
  <meta property="dc:date" content="{{ citationPublicationDate or publishedDate }}" />
  <meta property="dc:language" content="{{ metadata.language }}" />
  <meta property="dc:identifier" content="{{ canonicalUrl }}" />
  {% if doi %}<meta property="dc:identifier" content="doi:{{ doi }}" />{% endif %}
  <meta property="dc:source" content="{{ blogPublicationName }}" />
  {% if pageDesc %}<meta property="dc:description" content="{{ pageDesc }}" />{% endif %}
  {% for aName in schemaAuthors %}
  <meta property="dc:creator" content="{{ aName }}" />
  <meta name="citation_author" content="{{ aName }}" />
  {% endfor %}
  <meta name="citation_title" content="{{ pageTitle }}" />
  <meta name="citation_publication_date" content="{{ citationPublicationDate or publishedDate }}" />
  <meta name="citation_date" content="{{ citationPublicationDate or publishedDate }}" />
  <meta name="citation_fulltext_html_url" content="{{ canonicalUrl }}" />
  <meta name="citation_public_url" content="{{ canonicalUrl }}" />
  <meta name="citation_language" content="{{ metadata.language }}" />
  {% if doi %}<meta name="citation_doi" content="{{ doi }}" />{% endif %}
  <meta name="prism.genre" content="blogentry" />
  <meta name="prism.publicationName" content='{{ blogPublicationName }}' />
  {% if citationPublicationDate or publishedDate %}<meta name="prism.publicationDate" content="{{ citationPublicationDate or publishedDate }}" />{% endif %}
  {% for cat in (categories or []) %}
  <meta property="dc:subject" content="{{ cat }}" />
  {% endfor %}
  {% for subject in (subjects or []) %}
  <meta property="dc:subject" content="{{ subject.label }}" data-subject-scheme="{{ subject.scheme }}" data-subject-identifier="{{ subject.identifier }}" data-subject-uri="{{ subject.uri }}" data-subject-category="{{ subject.category }}" />
  {% endfor %}
{% else %}
  <meta property="dc:type" content="text" />
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["EducationalOrganization", "Organization"],
      "@id": "https://thewhitestonefoundation.org/#organization",
      "name": "The Whitestone Foundation",
      "alternateName": "Whitestone Publications",
      "legalName": "The Whitestone Foundation",
      "url": "https://thewhitestonefoundation.org/",
      "logo": "https://thewhitestonefoundation.org/images/whitestone-logo.png",
      "image": "https://thewhitestonefoundation.org/images/whitestone-logo.png",
      "description": "The Whitestone Foundation dba Whitestone Publications advances public-interest scholarship through open-access publications, programs, and global academic collaboration.",
      "sameAs": [
        "https://jcrt.org/",
        "https://www.facebook.com/religioustheory",
        "https://x.com/jourculreltheor",
        "https://mastodon.social/@jcrt",
        "https://bsky.app/profile/jcrt.org",
        "https://www.instagram.com/JCRT_DU1",
        "https://journal.thenewpolis.com/",
        "https://thenewpolis.com/",
        "https://esthesis.org/",
        "https://www.youtube.com/@whitestonepublications6661",
        "https://works.hcommons.org/collections/whitestone"
      ]
    },
    {
      "@type": ["Periodical", "Organization"],
      "@id": {{ metadata.knowledge_graph.organization_id | dump | safe }},
      "name": "The Journal for Cultural and Religious Theory",
      "alternateName": "JCRT",
      "url": "https://jcrt.org/",
      "issn": "1530-5228",
      "description": {{ metadata.description | dump | safe }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ (metadata.files_url ~ metadata.favicon) | dump | safe }},
        "width": 512,
        "height": 512
      },
      "image": {{ pageImage | dump | safe }},
      "sameAs": {{ metadata.knowledge_graph.same_as | dump | safe }},
      "publisher": { "@id": {{ metadata.knowledge_graph.publisher_id | dump | safe }} },
      "parentOrganization": { "@id": {{ metadata.knowledge_graph.publisher_id | dump | safe }} }
    },
    {
      "@type": "WebSite",
      "@id": {{ metadata.knowledge_graph.website_id | dump | safe }},
      "name": "The Journal for Cultural and Religious Theory",
      "url": "https://jcrt.org/",
      "publisher": { "@id": {{ metadata.knowledge_graph.organization_id | dump | safe }} },
      "inLanguage": {{ metadata.language | dump | safe }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://jcrt.org/search/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": {{ pageSchemaType | dump | safe }},
      "@id": {{ (canonicalUrl ~ "#webpage") | dump | safe }},
      "url": {{ canonicalUrl | dump | safe }},
      "name": {{ pageTitle | dump | safe }},
      "headline": {{ pageTitle | dump | safe }},
      "description": {{ (pageDesc | truncate(160)) | dump | safe }},
      "image": {{ pageImage | dump | safe }},
      "datePublished": {{ publishedDate | dump | safe }},
      "dateModified": {{ modifiedDate | dump | safe }},
      "inLanguage": {{ metadata.language | dump | safe }},
      "isPartOf": { "@id": {{ metadata.knowledge_graph.website_id | dump | safe }} },
      "publisher": { "@id": {{ metadata.knowledge_graph.organization_id | dump | safe }} },
      "author": [
        {% if schemaAuthors and (schemaAuthors | length > 0) %}
        {%- for aName in schemaAuthors %}
        {% set authorObj = collections.authors | getAuthorObj(aName) %}
        {% set authorPath = authorObj.url if authorObj and authorObj.url else ("/authors/" ~ (aName | authorSlug) ~ "/") %}
        {
          "@type": "Person",
          "name": {{ (aName | trim) | dump | safe }},
          "@id": {{ (metadata.url ~ authorPath ~ "#person") | dump | safe }},
          "url": {{ (metadata.url ~ authorPath) | dump | safe }}
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
        {% else %}
        { "@type": "Organization", "name": "JCRT", "@id": {{ metadata.knowledge_graph.organization_id | dump | safe }} }
        {% endif %}
      ],
      "mainEntityOfPage": { "@id": {{ canonicalUrl | dump | safe }} }{% if subjects and (subjects | length > 0) %},
      "about": [
        {% for subject in subjects %}{
          "@type": "DefinedTerm",
          "name": {{ subject.label | dump | safe }},
          "termCode": {{ subject.identifier | dump | safe }},
          "url": {{ subject.uri | dump | safe }},
          "inDefinedTermSet": {{ ("https://id.worldcat.org/fast/" if subject.scheme == "FAST" else "https://homosaurus.org/v5") | dump | safe }},
          "additionalProperty": { "@type": "PropertyValue", "name": "authority category", "value": {{ subject.category | dump | safe }} }
        }{% if not loop.last %},{% endif %}{% endfor %}
      ]{% endif %}{% if volume %},
      "volumeNumber": {{ volume | dump | safe }}{% endif %}{% if issue %},
      "issueNumber": {{ issue | dump | safe }}{% endif %}{% if doi %},
      "identifier": {{ doi | dump | safe }}{% endif %}{% if pdfUrl %},
      "encoding": {
        "@type": "MediaObject",
        "encodingFormat": "application/pdf",
        "contentUrl": {{ pdfUrl | dump | safe }}
      }{% endif %}
    },
    {
      "@type": "BreadcrumbList",
      "@id": {{ (canonicalUrl ~ "#breadcrumb") | dump | safe }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ metadata.url | dump | safe }}
        }{% if pg or post %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Religious Theory",
          "item": {{ (metadata.url ~ "/religioustheory/") | dump | safe }}
        }{% endif %},
        {
          "@type": "ListItem",
          "position": {{ 3 if (pg or post) else 2 }},
          "name": {{ pageTitle | dump | safe }},
          "item": {{ canonicalUrl | dump | safe }}
        }
      ]
    }
  ]
}
</script>
