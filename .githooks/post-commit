#!/bin/sh
# Keep CHANGELOG.md current: one entry per commit, versions incrementing by
# 00.00.01 from 00.00.00 at the initial commit.
#
# This runs AFTER the commit, because an entry names the commit it describes and
# a commit cannot contain its own subject line. The entry for the commit you just
# made is written now and travels with your NEXT commit — a one-commit lag that
# is inherent to per-commit changelogs, not a bug. `npm run changelog:check`
# fails only if the changelog is behind, so nothing silently drifts.
#
# Enabled via `git config core.hooksPath .githooks` (the `prepare` npm script).

if command -v node >/dev/null 2>&1; then
	NODE_BIN="$(command -v node)"
elif [ -s "$HOME/.nvm/nvm.sh" ]; then
	. "$HOME/.nvm/nvm.sh"
	NODE_BIN="$(command -v node 2>/dev/null)"
elif [ -x "/opt/homebrew/bin/node" ]; then
	NODE_BIN="/opt/homebrew/bin/node"
elif [ -x "/usr/local/bin/node" ]; then
	NODE_BIN="/usr/local/bin/node"
fi
[ -z "$NODE_BIN" ] && exit 0

ROOT="$(git rev-parse --show-toplevel)"
"$NODE_BIN" "$ROOT/scripts/update-changelog.mjs" >/dev/null 2>&1 || exit 0

if [ -n "$(git status --porcelain CHANGELOG.md)" ]; then
	echo "[changelog] CHANGELOG.md updated for the commit you just made — stage it with your next commit."
fi
