#!/bin/sh
# Write this commit's CHANGELOG.md entry INTO this commit, before it is created.
#
# The previous post-commit approach wrote the entry after the fact, which left
# the changelog dirty and required a second, content-free "Update CHANGELOG.md"
# commit — which then needed its own entry, and so on. Writing the entry here
# means one commit, no lag, and no self-perpetuating commits.
#
# Skipped for merges, squashes, and amends: those either have no meaningful new
# subject or would duplicate an entry that already exists.
#
# Enabled via `git config core.hooksPath .githooks` (the `prepare` npm script).

MSG_FILE="$1"
SOURCE="$2"

case "$SOURCE" in
	merge|squash) exit 0 ;;
esac
[ -n "$3" ] && exit 0   # amend (commit SHA passed) — entry already written

if command -v node >/dev/null 2>&1; then
	NODE_BIN="$(command -v node)"
elif [ -s "$HOME/.nvm/nvm.sh" ]; then
	. "$HOME/.nvm/nvm.sh"
	NODE_BIN="$(command -v node 2>/dev/null)"
elif [ -x "/opt/homebrew/bin/node" ]; then
	NODE_BIN="/opt/homebrew/bin/node"
elif [ -x "/usr/local/bin/node" ]; then
	NODE_BIN="/usr/local/bin/node"
fi
[ -z "$NODE_BIN" ] && exit 0

SUBJECT="$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -1)"
[ -z "$SUBJECT" ] && exit 0

ROOT="$(git rev-parse --show-toplevel)"
"$NODE_BIN" "$ROOT/scripts/update-changelog.mjs" --pending "$SUBJECT" >/dev/null 2>&1 || exit 0
git add "$ROOT/CHANGELOG.md" 2>/dev/null || true
exit 0
