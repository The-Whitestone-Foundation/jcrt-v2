---
layout: base.njk
pagination:
  data: tagIndex.authors.theory.list
  size: 1
  alias: authorSlugKey
permalink: "/religioustheory/authors/{{ authorSlugKey }}/index.html"
eleventyComputed:
  title: "Author: {{ tagIndex.authors.theory.names[authorSlugKey] or authorSlugKey }}"
# Eleventy adds only the FIRST page of a paginated template to collections.all, so a
# sweep advertises one arbitrary page and misses the rest. Dedicated sitemaps cover
# these URLs completely.
# Source: tagIndex.authors.theory.list (152 pages)
sitemapIgnore: true
---
{% set authorName = tagIndex.authors.theory.names[authorSlugKey] or authorSlugKey %}
{% set theoryPosts = tagIndex.authors.theory.map[authorSlugKey] or [] %}
<article class="collection-shell collection-shell--theory-author mt-5">
  {% include "partials/nav_desktop.njk" %}
  
  <header class="mb-5 text-center">
    <h1 class="display-4 fw-bold serif">{{ authorName }}</h1>
    <p>
      <a class="text-primary fw-bold text-decoration-none text-uppercase collection-back-link"
         href="/religioustheory/authors/">
        &larr; View All Authors
      </a>
    </p>
  </header>

  <div class="row mt-3 mb-3">
    {%- for post in theoryPosts %}
        <div class="col-md-6 col-lg-4 p-3 small p-md-5 d-flex flex-column"> 
            <div class="img-zoom-container rounded-4 shadow-sm mb-3 collection-card-media">
                <a href="{{ post.url }}">
                    {% set authorCardImage = (post.image | ensureImage('/images/jcrt-open-graph.webp')) %}
                    {% set authorCardImagePreferred = (authorCardImage | preferWebp) %}
                    <img class="img-post img-fluid collection-card-img"
                         alt="{{ post.title }}"
                         src="{{ authorCardImagePreferred }}"
                         data-fallback-src="{{ authorCardImage }}"
                         {% imageAttrs authorCardImage, 640, 360 %}
                         loading="lazy"
                         decoding="async"
                         onerror="if(this.dataset.fallbackAttempted){this.onerror=null;this.src='/images/jcrt-open-graph.webp';}else{this.dataset.fallbackAttempted='1';this.src=this.dataset.fallbackSrc||'/images/jcrt-open-graph.webp';}">
                </a>
            </div>

            <h3 class="serif fw-bold h5">
                <a class="text-decoration-none text-dark hover-primary" href="{{ post.url }}">
                    {{ post.title }}
                </a>
            </h3>
            
            <div class="mb-2">
                <p class="text-muted x-small text-uppercase fw-bold mb-1 collection-card-meta">
                    {% if post.date %}{{ post.date | postDate }}{% endif %}
                    — By {{ post.author or authorName }}
                </p>
            </div>

            <p class="text-secondary small">
                {{ post.description | truncate(110) if post.description else "Explore this article by " + authorName + "..." }}
            </p>

            <p class="mt-auto">
                <a href="{{ post.url }}" class="btn btn-primary px-4 py-2 fw-bold text-uppercase collection-card-action">
                    Learn More
                </a>
            </p>
        </div>
    {%- endfor %}
  </div>
</article>
