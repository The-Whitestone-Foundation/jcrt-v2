---
layout: base.njk
title: Tags & Categories Archive
permalink: /religioustheory/taxonomy/index.html
# Navigation index only: every target here is individually indexed under
# /religioustheory/categories/ and /religioustheory/tags/, so keeping this tree out of
# the search index and out of the crawl avoids a large block of duplicate Pagefind
# fragments. The URL and the page itself stay exactly as they were -- the per-term
# listings moved to /religioustheory/taxonomy/<letter>/ (see taxonomy-letters.njk).
searchIndex: false
robots: "noindex, follow"
# The religioustheory sitemap lists this URL explicitly in its canonical-index block, and
# also sweeps collections.all -- which listed it a second time. Ignore the sweep copy.
sitemapIgnore: true
---

<div class="collection-shell collection-shell--theory-taxonomy">
  {% include "partials/nav_desktop.njk" %}
  <h1 class="display-5 fw-bold mb-3 border-bottom pb-3">Digital Archive Index</h1>

  <p class="text-secondary mb-5">
    {{ tagIndex.theory.categories.list | length }} categories and
    {{ tagIndex.theory.tags.list | length }} tags, grouped by first character.
    Pick a letter to browse its terms and the posts filed under each.
  </p>

  <div class="row g-3 mb-5">
    {%- for letter in tagIndex.theory.taxonomyLetters %}
      {%- set letterCats = tagIndex.theory.categories.byLetter[letter] or [] -%}
      {%- set letterTags = tagIndex.theory.tags.byLetter[letter] or [] -%}
      <div class="col-md-3 col-4">
        <a href="/religioustheory/taxonomy/{{ letter | lower }}/" class="text-decoration-none">
          <div class="card h-100 shadow-sm border-0 bg-light transition-all hover-shadow">
            <div class="card-body p-3 text-center">
              <h2 class="h3 fw-bold mb-1 text-dark">{{ letter }}</h2>
              <span class="text-muted small d-block">{{ letterCats | length }} categories</span>
              <span class="text-muted small d-block">{{ letterTags | length }} tags</span>
            </div>
          </div>
        </a>
      </div>
    {%- endfor %}
  </div>

  <p class="small">
    <a class="text-decoration-none" href="/religioustheory/categories/">All categories</a>
    &nbsp;&middot;&nbsp;
    <a class="text-decoration-none" href="/religioustheory/tags/">All tags</a>
  </p>
</div>
