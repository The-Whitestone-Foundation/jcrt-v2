/
  Link: </standard.site/manifest.json>; rel="api-catalog"
  Link: </standard.site/documents.json>; rel="describedby"
  Link: </submissions/>; rel="service-doc"

/.well-known/traffic-advice
  Content-Type: application/trafficadvice+json

/css/*
  Cache-Control: public, max-age=345600, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=345600, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=172800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept, Range
  Access-Control-Expose-Headers: Content-Length, Content-Range, ETag

/images/logos/site.webmanifest
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept, Range

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept, Range
  Access-Control-Expose-Headers: Content-Length, Content-Range, ETag

# Unhashed pagefind files (pagefind.js, pagefind-ui.js, entry.json, wasm)
# change on upgrade/deploy under the same URL — revalidate, never cache long.
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept, Range
  Access-Control-Expose-Headers: Content-Length, Content-Range, ETag

# Version-busted component bundles: /pagefind/v/:version/* rewrites to /pagefind/:splat
# (public/_redirects), and measured on 2026-09-01 the served header was the /pagefind/*
# max-age=0 above, not this one — so this rule must sit AFTER the wildcard, and the edge
# TTL for /pagefind/v/ is pinned in a Cloudflare Cache Rule regardless. See
# jcrt-meta/docs/cloudflare-cache.md.
/pagefind/v/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept, Range
  Access-Control-Expose-Headers: Content-Length, Content-Range, ETag

# Content-hashed index/fragment chunks are safe to cache long.
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept, Range
  Access-Control-Expose-Headers: Content-Length, Content-Range, ETag

/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept, Range
  Access-Control-Expose-Headers: Content-Length, Content-Range, ETag

/badges/*
  Cache-Control: public, max-age=172800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept, Range
  Access-Control-Expose-Headers: Content-Length, Content-Range, ETag
